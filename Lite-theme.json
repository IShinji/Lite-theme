{
  "name": "Lite-Theme",
  "short": "lite-theme",
  "description": "Lite 官方公共大屏主题，使用与 Lite 管理后台一致的界面语言。",
  "version": "1.2.6",
  "author": "Nomi",
  "url": "https://github.com/nuomiiiii/Lite-theme",
  "preview": "preview.png",
  "navigation": {
    "server_detail": "/server/{uuid}",
    "server_network": "/server/{uuid}?view=network",
    "ping_task_parameter": "ping_task"
  },
  "configuration": {
    "type": "managed",
    "data": [
      { "name": "外观设置", "type": "title" },
      {
        "key": "CustomBackgroundImage",
        "name": "背景图片",
        "type": "input",
        "default": "",
        "help": "桌面端背景图片 URL，留空使用主题默认背景。"
      },
      {
        "key": "CustomMobileBackgroundImage",
        "name": "移动端背景图片",
        "type": "input",
        "default": "",
        "help": "移动端单独的背景图片 URL，留空时跟随桌面端。"
      },
      {
        "key": "CustomLogo",
        "name": "站点 Logo",
        "type": "input",
        "default": "/favicon.ico",
        "help": "留空时跟随 Lite 后台的站点图标。"
      },
      {
        "key": "ForceTheme",
        "name": "强制主题",
        "type": "select",
        "options": "跟随系统,dark,light",
        "default": "跟随系统",
        "help": "选择跟随系统时，访客可以在大屏右上角切换主题。"
      },
      { "name": "内容设置", "type": "title" },
      {
        "key": "ForcePeakCutEnabled",
        "name": "网络图表削峰",
        "type": "switch",
        "default": false,
        "help": "裁剪异常峰值，使网络趋势更易读。"
      },
      {
        "key": "DefaultProbeChartHours",
        "name": "探测延迟默认时间",
        "type": "select",
        "options": "1h,6h,12h,24h,3d,7d,30d",
        "default": "1h",
        "help": "网络监测页「全部探测延迟」打开时使用的时间范围。访客仍可在图表上自行切换。"
      },
      {
        "key": "ShowHomePacketLoss",
        "name": "显示丢包率",
        "type": "switch",
        "default": false,
        "help": "打开后在首页卡片的网络质量里显示每条探测的丢包率。"
      },
      {
        "key": "ShowServerRemainingValue",
        "name": "显示剩余价值",
        "type": "switch",
        "default": true,
        "help": "打开后在首页卡片「剩余 XXX 天」旁边显示该服务器的剩余价值。"
      },
      {
        "key": "ShowServerBandwidth",
        "name": "显示带宽",
        "type": "switch",
        "default": false,
        "help": "打开后在卡片右下角显示该服务器设置的带宽。"
      },
      {
        "key": "ShowMobileHomeOverview",
        "name": "手机端显示概览",
        "type": "switch",
        "default": false,
        "help": "打开后在手机端首页显示连接数、实时流量、累计流量、CPU、内存和硬盘这六个概览卡片。默认隐藏。"
      },
      { "name": "探测任务", "type": "title" },
      {
        "key": "HomeProbeTasks",
        "name": "首页探测任务",
        "type": "serverpingtasks",
        "default": {},
        "help": "只影响本主题首页卡片，最多显示 4 个。不会改延迟监测里的任务顺序，其他主题也不受影响。未设置的服务器继续跟随延迟任务顺序。"
      }
    ]
  }
}
